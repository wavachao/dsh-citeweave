# Copy to .env. Never commit credentials.
# Required for network/container deployment; use at least 32 random characters.
CITEWEAVE_ACCESS_TOKEN=
CITEWEAVE_CACHE_TTL=900
CITEWEAVE_RATE_LIMIT=10
# Optional Google DNS over HTTPS for fake-IP or polluted system DNS.
CITEWEAVE_DOH=0
CITEWEAVE_BACKEND=local
CITEWEAVE_MODEL=models/Qwen2.5-7B-Instruct
CITEWEAVE_VISION_MODEL=models/Qwen2.5-VL-3B-Instruct
CITEWEAVE_EMBEDDING_MODEL=models/bge-small-en-v1.5
CITEWEAVE_RANKER=runs/ranker/best.pt
CITEWEAVE_MAX_INPUT_TOKENS=24576
CITEWEAVE_MAX_NEW_TOKENS=1600
CITEWEAVE_MAX_IMAGES=10
# Set BACKEND=api only after filling these fields.
CITEWEAVE_API_BASE=https://api.deepseek.com
CITEWEAVE_API_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Optional vLLM OpenAI-compatible backend; preserves local defaults above.
# Set CITEWEAVE_BACKEND=api and use the served model name, not a filesystem path.
# CITEWEAVE_API_TYPE=vllm
# CITEWEAVE_API_BASE=http://127.0.0.1:8000/v1
# CITEWEAVE_API_MODEL=citeweave-vlm
# CITEWEAVE_API_KEY=
# CITEWEAVE_VISION_BACKEND=api
# CITEWEAVE_VISION_API_BASE=http://127.0.0.1:8000/v1
# CITEWEAVE_VISION_API_MODEL=citeweave-vlm
# CITEWEAVE_VISION_API_KEY=
# CITEWEAVE_RANKER_DEVICE=cpu
# Optional durable queue. Dependencies are included in pyproject.toml and uv.lock.
# CITEWEAVE_QUEUE=celery
# CITEWEAVE_BROKER_URL=redis://:password@127.0.0.1:6379/0
# CITEWEAVE_RESULT_BACKEND=db+postgresql://citeweave:password@127.0.0.1:5432/citeweave
# CITEWEAVE_MAX_WAITING=4
# CITEWEAVE_JOB_WAIT_TIMEOUT=280
# CITEWEAVE_RESULT_TTL=86400
# Optional shared-GPU lifecycle; requires the queued backend and model watcher.
# CITEWEAVE_MODEL_LIFECYCLE=ondemand
# CITEWEAVE_VLLM_CONTAINER=dsh-citeweave-vllm
# CITEWEAVE_MODEL_IDLE_SECONDS=120
# CITEWEAVE_MODEL_START_TIMEOUT=120
# CITEWEAVE_MODEL_MIN_FREE_MIB=11316
# Optional SearXNG JSON endpoint; default search uses DDGS.
SEARXNG_URL=
# Official evaluation is opt-in and requires separately configured judge keys.
OPENAI_API_KEY=
